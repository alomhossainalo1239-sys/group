# ============================================================
# এই ফাইলের নাম হবে ".env" (এই .env.example নয়)
# bot.py যেই ফোল্ডারে আছে, সেই একই ফোল্ডারে এটা রাখবেন
# ============================================================

# আপনার বট টোকেন। এটা পাবেন Telegram-এ @BotFather কে মেসেজ দিয়ে
# /newbot কমান্ড দিলে। এইরকম দেখতে হবে: 123456789:AAExampleTokenABC
BOT_TOKEN=এখানে_আপনার_আসল_বট_টোকেন_বসান

# এটা এমনিতেই থাকবে, কিছু পরিবর্তন করা লাগবে না
DATABASE_PATH=bot.db

# ============================================================
# নিচের ৩টা লাইন Render/Railway-এর মতো ওয়েবহুক ডিপ্লয়মেন্টের জন্য।
# শুধু নিজের কম্পিউটারে/VPS-এ চালালে এগুলো খালি রাখুন (কিছু লিখবেন না)।
# ============================================================
WEBHOOK_URL=
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8443
WEBHOOK_SECRET_TOKEN=
